{
  "name": "agentic-playwright-tests",
  "version": "1.0.0",
  "description": "A high-quality, product-agnostic Playwright + TypeScript E2E and API test framework template",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "HEADLESS=false playwright test",
    "test:debug": "HEADLESS=false playwright test --debug",
    "test:ui": "HEADLESS=false playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:cross-browser": "CROSS_BROWSER=true playwright test",
    "test:parallel": "playwright test --workers=8",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:critical": "playwright test --grep \"@critical\"",
    "test:regression": "playwright test --grep \"@regression\"",
    "test:api": "playwright test tests/api/",
    "test:ui:only": "playwright test tests/ui/",
    "test:navigation": "playwright test --grep \"@navigation\"",
    "test:responsive": "playwright test --grep \"@responsive\"",
    "test:visual": "playwright test --grep \"@visual\"",
    "test:ci": "CI=true PARALLEL_WORKERS=8 playwright test --grep \"@smoke|@critical\"",
    "test:ci:full": "CI=true PARALLEL_WORKERS=8 playwright test",
    "test:ci:cross-browser": "CI=true CROSS_BROWSER=true PARALLEL_WORKERS=6 playwright test --grep \"@smoke\"",
    "test:report": "bash scripts/test-and-report.sh",
    "test:report:smoke": "bash scripts/test-and-report.sh --grep @smoke",
    "test:report:critical": "bash scripts/test-and-report.sh --grep @critical",
    "test:report:regression": "bash scripts/test-and-report.sh --grep @regression",
    "test:report:api": "bash scripts/test-and-report.sh --grep @api",
    "test:report:ui": "bash scripts/test-and-report.sh --grep @ui",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "bun run allure:generate && bun run allure:open",
    "clean": "rm -rf allure-results allure-report test-results playwright-report",
    "codegen": "playwright codegen ${BASE_URL:-https://example.com}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "api-testing",
    "test-automation",
    "template"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "dotenv": "^17.2.4",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.7.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.1"
  }
}
